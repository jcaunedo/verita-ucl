{
  "name": "verita-ai-ucl",
  "version": "0.1.0",
  "type": "module",
  "description": "Verita AI Unified Content Library - shared React component library",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/styles/theme.css dist/styles.css && node scripts/add-use-client.mjs",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6009",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "formik": "^2.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "formik": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@untitledui/icons": "^0.0.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.7",
    "react-aria-components": "^1.21.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "formik": "^2.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
